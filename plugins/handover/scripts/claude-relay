#!/usr/bin/env bash
# Kept for older callers: the relay launcher now lives in the toolbox CLI, as
# `toolbox session run` (named sessions and AFK runs: `toolbox session create`).
# Arguments pass through untouched; the contract between toolbox and handover.py
# (the HANDOVER_* variables, `handover.py until|yolo-settings`) is documented in
# toolbox's docs/handover-relay.md.
#
#   claude-relay [claude args]
#   claude-relay --afk '<goal>' [--until <when>] [--yolo] [claude args]
set -euo pipefail

if ! command -v toolbox >/dev/null 2>&1; then
  echo "claude-relay: the relay now runs as 'toolbox session run'; install toolbox: brew install fundrivendev/tap/toolbox" >&2
  exit 1
fi
exec toolbox session run "$@"
