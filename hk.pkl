amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"

// Git hooks call the Justfile, never the tools behind it (fundrivenOS rules/ci/hooks.md).
// They are the PR's CI: GitHub Actions runs ci.yml on main, weekly, by hand and on
// Renovate's PRs.
hooks {
    // Narrow and fast: no secret and no lint error in the staged files; unstaged work
    // is stashed meanwhile.
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps {
            ["secrets"] {
                check = "just audit staged"
            }
            ["just"] {
                glob = "**/*"
                check = "just lint staged"
                fix = "just fmt staged && just lint staged"
            }
        }
    }
    // Everything before it leaves the machine: lint, smoke tests, version bumps,
    // type-check, the validator and the mods' tests, then the history's secrets and
    // the workflows' audit.
    ["pre-push"] {
        steps {
            ["check"] {
                check = "just check"
            }
            ["audit"] {
                check = "just audit"
            }
        }
    }
}
